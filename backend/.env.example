# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL / XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=attendanceApp

# CORS Configuration (use comma-separated domains or * for dev)
CLIENT_URL=*
CORS_ORIGIN=*

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Organization Location & Attendance Configuration (defaults match system_settings)
ORGANIZATION_LATITUDE=18.517222
ORGANIZATION_LONGITUDE=73.808722
ATTENDANCE_RADIUS_METERS=10
TIMEZONE=Asia/Kolkata
MAX_ALLOWED_ACCURACY_METERS=50

# Security & Rate Limiting
REQUEST_BODY_LIMIT=100kb
AUTH_RATE_LIMIT_MAX=15
AUTH_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=500

# Push Notification Providers (Optional - local database notifications work without credentials)
EXPO_PUSH_ACCESS_TOKEN=
FIREBASE_SERVICE_ACCOUNT_KEY=
